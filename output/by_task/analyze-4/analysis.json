  "constraints": [
    {
      "constraintRef": "C_RULE_003",
      "description": "System must maintain unalterable audit trail",
      "related_functions": [
        "ExportAuditTrail"
      ],
      "source_text": "The System must keep an unalterable audit trail capable of automatically capturing and storing information about:The word \"unalterable\" is to mean that the audit trail data cannot be modified in any way or deleted by any user; it may be subject to re-department and copying to removable media if required, so long as its contents remain unchanged."
    },
    {
      "constraintRef": "C_RULE_004",
      "description": "System must track events automatically",
      "related_functions": [
        "ExportAuditTrail"
      ],
      "source_text": "Once the audit trail functionality has been activated, the System must track events without manual intervention, and store in the audit trail information about them."
    },
    {
      "constraintRef": "C_RULE_005",
      "description": "System must allow case access limitation",
      "related_functions": [
        "ConfigureAccess"
      ],
      "source_text": "The System must allow the user to limit access to cases to specified users or user groups."
    },
    {
      "constraintRef": "C_RULE_006",
      "description": "Only admins can manage user profiles",
      "related_functions": [
        "ManageUserProfile"
      ],
      "source_text": "The System must allow only admin-users to set up user profiles and allocate users to groups."
    },
    {
      "constraintRef": "C_RULE_012",
      "description": "No hard deletes, only soft deletes",
      "related_functions": [],
      "source_text": "Do not allow hard delete and perform only soft tagging the row for deletion"
    }
  ],
  "missingConstraintCandidates": [],
  "exceptions": [
    {
      "id": "X001",
      "description": "Unauthorized case access attempt",
      "trigger": "User tries to access a case they don't have permission for",
      "handling": "Log in audit trail and show appropriate message"
    },
    {
      "id": "X002",
      "description": "Case not found",
      "trigger": "User tries to access a non-existent case",
      "handling": "Show error message"
    },
    {
      "id": "X003",
      "description": "Invalid search criteria",
      "trigger": "User provides invalid search parameters",
      "handling": "Show validation errors"
    }
  ],
