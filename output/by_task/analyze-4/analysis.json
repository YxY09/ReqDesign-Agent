  "entities": [
    {
      "entityRef": "E_CASE",
      "name": "Case",
      "description": "Police case record",
      "attributes": [
        {
          "name": "caseId",
          "type": "String",
          "description": "Unique case identifier"
        },
        {
          "name": "title",
          "type": "String",
          "description": "Case title"
        },
        {
          "name": "description",
          "type": "String",
          "description": "Case description"
        },
        {
          "name": "status",
          "type": "String",
          "description": "Current status of the case"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "description": "When the case was created"
        },
        {
          "name": "lastAccessed",
          "type": "DateTime",
          "description": "When the case was last accessed"
        }
      ],
      "relationships": [
        {
          "target": "Suspect",
          "type": "one-to-many",
          "description": "Case can have multiple suspects"
        },
        {
          "target": "Property",
          "type": "one-to-many",
          "description": "Case can involve multiple properties"
        }
      ]
    },
    {
      "entityRef": "E_SUSPECT",
      "name": "Suspect",
