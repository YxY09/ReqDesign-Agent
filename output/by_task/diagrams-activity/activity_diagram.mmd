flowchart TD
    %% 案件注册流程
    subgraph 案件注册流程
        A1([开始]) --> A2[公民提交投诉]
        A2 --> A3[警务人员审核]
        A3 --> A4{信息完整?}
        A4 -->|是| A5[生成案件记录]
        A4 -->|否| A6[退回补充信息]
        A5 --> A7[通知相关人员]
        A7 --> A8([结束])
        A6 --> A2
    end
    %% 案件调查流程
    subgraph 案件调查流程
        B1([开始]) --> B2[分配调查人员]
        B2 --> B3[收集证据]
        B3 --> B4[记录调查结果]
        B4 --> B5[更新案件状态]
        B5 --> B6([结束])
    end
    %% 案件起诉流程
    subgraph 案件起诉流程
        C1([开始]) --> C2[准备起诉材料]
        C2 --> C3{材料合规?}
        C3 -->|是| C4[提交法院]
        C3 -->|否| C5[补充材料]
        C4 --> C6[记录法院反馈]
        C6 --> C7[更新案件状态]
        C7 --> C8([结束])
        C5 --> C2
    end
    %% 案件搜索流程
    subgraph 案件搜索流程
        D1([开始]) --> D2[输入搜索条件]
        D2 --> D3[执行搜索]
        D3 --> D4{结果超时?}
        D4 -->|否| D5[过滤结果]
        D4 -->|是| D6[X003: 终止搜索]
        D5 --> D7[显示匹配案件]
        D7 --> D8([结束])
        D6 --> D8
    end
    %% 缺陷跟踪流程
    subgraph 缺陷跟踪流程
        E1([开始]) --> E2[用户提交缺陷]
        E2 --> E3{必填完整?}
        E3 -->|是| E4[帮助台分类]
        E3 -->|否| E5[X011: 显示错误]
        E4 --> E6[分配处理人员]
        E6 --> E7[更新状态]
        E7 --> E8[通知用户]
        E8 --> E9([结束])
        E5 --> E2
    end
    %% 审计检查流程
    subgraph 审计检查流程
        F1([开始]) --> F2[选择审计案件]
        F2 --> F3{审计功能激活?}
        F3 -->|是| F4[生成审计报告]
        F3 -->|否| F5[X002: 提示激活]
        F4 --> F6[导出审计数据]
        F6 --> F7([结束])
        F5 --> F7
    end
    %% 权限检查节点
    A3 --> G1{用户权限?}
    G1 -->|无权| G2[X005: 拒绝访问]
    G1 -->|有权| A4
    B2 --> G3{用户权限?}
    G3 -->|无权| G4[X018: 记录违规]
    G3 -->|有权| B3
    C2 --> G5{用户权限?}
    G5 -->|无权| G6[X019: 记录违规]
    G5 -->|有权| C3
    D3 --> G7{用户权限?}
    G7 -->|无权| G8[X017: 过滤结果]
    G7 -->|有权| D4
    %% Help模块流程
    subgraph Help模块
        H1([开始]) --> H2[用户提交帮助请求]
        H2 --> H3{请求类型?}
        H3 -->|缺陷报告| H4[进入缺陷跟踪流程]
        H3 -->|功能咨询| H5[分配咨询人员]
        H5 --> H6[记录解决方案]
        H6 --> H7[更新知识库]
        H7 --> H8([结束])
        H4 --> E2
    end