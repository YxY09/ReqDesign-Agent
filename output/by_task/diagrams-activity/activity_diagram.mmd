flowchart TD
    %% 案件注册流程
    subgraph 案件注册流程
        A1([开始]) --> A2[公民提交投诉]
        A2 --> A3{投诉有效?}
        A3 -->|是| A4[分配案件编号]
        A4 --> A5[通知警务人员]
        A5 --> A6([结束])
        A3 -->|否| A7[显示错误信息]
        A7 --> A6
    end
    %% 案件调查流程
    subgraph 案件调查流程
        B1([开始]) --> B2[警务人员查看案件]
        B2 --> B3{有权限?}
        B3 -->|是| B4[添加嫌疑人]
        B4 --> B5[收集证据]
        B5 --> B6[更新案件状态]
        B6 --> B7([结束])
        B3 -->|否| B8[X002: 记录未授权访问]
        B8 --> B9[显示错误信息]
        B9 --> B7
    end
    %% 案件起诉流程
    subgraph 案件起诉流程
        C1([开始]) --> C2[准备起诉材料]
        C2 --> C3{案件状态允许?}
        C3 -->|是| C4[提交法院]
        C4 --> C5[记录法院反馈]
        C5 --> C6([结束])
        C3 -->|否| C7[X008: 阻止修改]
        C7 --> C8[记录审计日志]
        C8 --> C6
    end
    %% 案件搜索流程
    subgraph 案件搜索流程
        D1([开始]) --> D2[输入搜索条件]
        D2 --> D3{权限验证}
        D3 -->|通过| D4[执行搜索]
        D4 --> D5{找到结果?}
        D5 -->|是| D6[显示结果]
        D6 --> D7([结束])
        D5 -->|否| D8[X003: 案件不存在]
        D8 --> D9[显示错误信息]
        D9 --> D7
        D3 -->|未通过| D10[X004: 未授权访问]
        D10 --> D11[记录审计日志]
        D11 --> D7
    end
    %% 界面定制流程
    subgraph 界面定制流程
        E1([开始]) --> E2[用户登录]
        E2 --> E3[访问界面设置]
        E3 --> E4[调整界面元素]
        E4 --> E5{保存配置?}
        E5 -->|是| E6[保存配置]
        E6 --> E7([结束])
        E5 -->|否| E8[放弃更改]
        E8 --> E7
    end
    %% 审计跟踪导出流程
    subgraph 审计跟踪导出流程
        F1([开始]) --> F2[选择案件]
        F2 --> F3{有权限?}
        F3 -->|是| F4[请求导出]
        F4 --> F5[生成报告]
        F5 --> F6[下载报告]
        F6 --> F7([结束])
        F3 -->|否| F8[X001: 记录违规]
        F8 --> F9[显示错误信息]
        F9 --> F7
    end
    %% 用户权限管理流程
    subgraph 用户权限管理流程
        G1([开始]) --> G2[管理员登录]
        G2 --> G3[选择用户]
        G3 --> G4[设置权限]
        G4 --> G5{保存配置?}
        G5 -->|是| G6[保存配置]
        G6 --> G7([结束])
        G5 -->|否| G8[放弃更改]
        G8 --> G7
    end
    %% 缺陷跟踪流程
    subgraph 缺陷跟踪流程
        H1([开始]) --> H2[用户报告缺陷]
        H2 --> H3[分配优先级]
        H3 --> H4[调查缺陷]
        H4 --> H5[解决问题]
        H5 --> H6[通知用户]
        H6 --> H7([结束])
    end
    %% 离线访问流程
    subgraph 离线访问流程
        I1([开始]) --> I2[尝试访问案件]
        I2 --> I3{数据已缓存?}
        I3 -->|是| I4[显示本地数据]
        I4 --> I5([结束])
        I3 -->|否| I6[X005: 数据不可用]
        I6 --> I7[提示重新连接]
        I7 --> I5
    end