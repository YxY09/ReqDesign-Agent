stateDiagram-v2
    state "案件" as Case {
        [*] --> 已创建
        已创建 --> 调查中 : 分配调查员
        调查中 --> 起诉准备中 : 调查完成
        起诉准备中 --> 已起诉 : 提交法庭
        调查中 --> 已关闭 : 调查终止(X008)
        起诉准备中 --> 已关闭 : 放弃起诉
        已起诉 --> 已关闭 : 法庭判决完成
        已关闭 --> [*]
    }
    state "嫌疑人" as Suspect {
        [*] --> 待调查
        待调查 --> 调查中 : 关联案件
        调查中 --> 已起诉 : 证据充分
        调查中 --> 已释放 : 证据不足
        已起诉 --> 已定罪 : 法庭判决有罪
        已起诉 --> 已释放 : 法庭判决无罪
        已定罪 --> [*]
        已释放 --> [*]
    }
    state "文档" as Document {
        [*] --> 待上传
        待上传 --> 已上传 : 上传成功
        待上传 --> 上传失败 : 网络问题
        上传失败 --> 已上传 : 重试成功
        已上传 --> 已归档 : 案件关闭
        已归档 --> [*]
    }
    state "审计跟踪" as AuditTrail {
        [*] --> 活动
        活动 --> 已归档 : 案件关闭
        已归档 --> 已导出 : 管理员导出(F003)
        已导出 --> [*]
    }
    state "财产" as Property {
        [*] --> 待登记
        待登记 --> 已登记 : 录入系统
        已登记 --> 已扣押 : 法庭命令
        已登记 --> 已释放 : 调查结束
        已扣押 --> 已释放 : 法庭判决
        已释放 --> [*]
    }
    state "用户配置" as UserProfile {
        [*] --> 活跃
        活跃 --> 已停用 : 管理员操作
        已停用 --> 活跃 : 重新激活
        活跃 --> [*]
    }
    state "投诉" as Complaint {
        [*] --> 已提交
        已提交 --> 已受理 : 确认有效
        已提交 --> 已拒绝 : 确认无效
        已受理 --> 已关联案件 : 创建案件(F008)
        已关联案件 --> [*]
        已拒绝 --> [*]
    }
    state "搜索" as Search {
        [*] --> 待查询
        待查询 --> 查询中 : 用户输入
        查询中 --> 结果返回 : 查询成功
        查询中 --> 查询失败 : X007
        查询失败 --> 结果返回 : 简化查询
        结果返回 --> [*]
    }
    state "缺陷跟踪" as Defect {
        [*] --> 新建
        新建 --> 已分配 : 分配给开发人员
        已分配 --> 处理中 : 开始处理
        处理中 --> 已解决 : 修复完成
        已解决 --> 已关闭 : 验证通过
        已解决 --> 已分配 : 需要返工
        已关闭 --> [*]
    }