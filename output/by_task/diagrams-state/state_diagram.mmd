stateDiagram-v2
    state "案件(Case)" as Case {
        [*] --> 新建
        新建 --> 调查中 : 分配调查员
        调查中 --> 起诉中 : 调查完成
        调查中 --> 已关闭 : 调查无结果
        起诉中 --> 已判决 : 法院裁决
        起诉中 --> 已关闭 : 撤诉
        已判决 --> [*]
        已关闭 --> [*]
    }
    state "案件登记(CaseRegistration)" as CaseRegistration {
        [*] --> 待审核
        待审核 --> 已登记 : 审核通过
        待审核 --> 已拒绝 : 审核不通过
        已登记 --> [*]
        已拒绝 --> [*]
    }
    state "案件调查(CaseInvestigation)" as CaseInvestigation {
        [*] --> 进行中
        进行中 --> 已完成 : 调查完成
        进行中 --> 已中止 : 调查中止
        已完成 --> [*]
        已中止 --> [*]
    }
    state "案件起诉(CaseProsecution)" as CaseProsecution {
        [*] --> 准备中
        准备中 --> 审理中 : 提交法院
        审理中 --> 已判决 : 法院裁决
        审理中 --> 已撤回 : 撤诉
        已判决 --> [*]
        已撤回 --> [*]
    }
    state "审计跟踪(AuditTrail)" as AuditTrail {
        [*] --> 活跃
        活跃 --> 已归档 : 达到保留期限
        已归档 --> [*]
    }
    state "用户配置(UserProfile)" as UserProfile {
        [*] --> 活跃
        活跃 --> 已停用 : 管理员停用
        已停用 --> 活跃 : 管理员启用
        活跃 --> [*]
        已停用 --> [*]
    }
    state "缺陷请求(DefectRequest)" as DefectRequest {
        [*] --> 待处理
        待处理 --> 处理中 : 分配处理人
        处理中 --> 已解决 : 修复完成
        处理中 --> 已拒绝 : 评估不通过
        已解决 --> [*]
        已拒绝 --> [*]
    }
    state "警报(Alert)" as Alert {
        [*] --> 待发送
        待发送 --> 已发送 : 发送成功
        待发送 --> 发送失败 : 发送失败
        发送失败 --> 已发送 : 重试成功
        发送失败 --> 已放弃 : 重试失败
        已发送 --> [*]
        已放弃 --> [*]
    }
    state "访问违规(AccessViolation)" as AccessViolation {
        [*] --> 已记录
        已记录 --> 已处理 : 管理员处理
        已记录 --> 已忽略 : 自动忽略
        已处理 --> [*]
        已忽略 --> [*]
    }