stateDiagram-v2
    state "Case" as Case {
        [*] --> 已注册
        已注册 --> 调查中 : 分配调查人员
        调查中 --> 起诉中 : 收集足够证据
        调查中 --> 已关闭 : 证据不足
        起诉中 --> 已结案 : 法庭判决
        起诉中 --> 调查中 : 需要补充证据
        已结案 --> [*]
        已关闭 --> [*]
    }
    state "Suspect" as Suspect {
        [*] --> 未确认
        未确认 --> 已确认 : 身份验证通过
        已确认 --> 调查中 : 关联到案件
        调查中 --> 已起诉 : 证据充分
        调查中 --> 已排除 : 证据不足
        已起诉 --> 已判刑 : 法庭判决
        已起诉 --> 已释放 : 无罪释放
        已判刑 --> [*]
        已释放 --> [*]
        已排除 --> [*]
    }
    state "Property" as Property {
        [*] --> 未登记
        未登记 --> 已登记 : 关联到案件
        已登记 --> 已扣押 : 作为证据
        已扣押 --> 已归还 : 调查结束
        已扣押 --> 已没收 : 法庭判决
        已归还 --> [*]
        已没收 --> [*]
    }
    state "Document" as Document {
        [*] --> 草稿
        草稿 --> 已提交 : 上传完成
        已提交 --> 已归档 : 审核通过
        已提交 --> 已拒绝 : 审核不通过
        已拒绝 --> 已提交 : 重新提交
        已归档 --> [*]
    }
    state "Complaint" as Complaint {
        [*] --> 已提交
        已提交 --> 处理中 : 分配给调查人员
        处理中 --> 已解决 : 问题解决
        处理中 --> 已驳回 : 证据不足
        已解决 --> [*]
        已驳回 --> [*]
    }
    state "UserProfile" as UserProfile {
        [*] --> 未激活
        未激活 --> 已激活 : 管理员批准
        已激活 --> 已停用 : 违反安全策略
        已停用 --> 已激活 : 管理员恢复
        已激活 --> [*]
        已停用 --> [*]
    }
    state "SearchResult" as SearchResult {
        [*] --> 准备中
        准备中 --> 已完成 : 搜索成功
        准备中 --> 已失败 : 搜索超时(X001)
        已失败 --> 已完成 : 重试成功
        已完成 --> [*]
    }