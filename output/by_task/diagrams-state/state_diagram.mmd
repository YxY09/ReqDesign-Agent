stateDiagram-v2
    state "案件(Case)" as Case {
        [*] --> 新案件
        新案件 --> 调查中 : 分配调查员
        调查中 --> 起诉中 : 收集足够证据
        调查中 --> 已关闭 : 证据不足
        起诉中 --> 已判决 : 法庭判决
        起诉中 --> 已关闭 : 撤诉
        已判决 --> [*]
        已关闭 --> [*]
    }
    state "嫌疑人(Suspect)" as Suspect {
        [*] --> 未调查
        未调查 --> 调查中 : 关联到案件
        调查中 --> 已起诉 : 证据充分
        调查中 --> 已排除 : 证据不足
        已起诉 --> 已判决 : 法庭判决
        已排除 --> [*]
        已判决 --> [*]
    }
    state "财产/证据(Property)" as Property {
        [*] --> 未登记
        未登记 --> 已登记 : 关联到案件
        已登记 --> 作为证据 : 标记为证据(C044)
        作为证据 --> 已释放 : 法庭释放
        已释放 --> [*]
    }
    state "审计跟踪(AuditTrail)" as AuditTrail {
        [*] --> 未激活
        未激活 --> 激活中 : 管理员启用(C065)
        激活中 --> 记录中 : 系统事件发生
        记录中 --> 导出中 : 审计员请求导出(C078)
        导出中 --> 记录中 : 导出完成
        记录中 --> [*] : 案件关闭(C069)
    }
    state "用户配置(UserProfile)" as UserProfile {
        [*] --> 默认配置
        默认配置 --> 自定义中 : 用户修改界面(F001)
        自定义中 --> 配置保存 : 用户确认
        自定义中 --> 默认配置 : 用户重置
        配置保存 --> [*] : 系统更新(C056)
    }
    state "访问控制(AccessControl)" as AccessControl {
        [*] --> 基础权限
        基础权限 --> 权限变更 : 超级用户修改(C023)
        权限变更 --> 权限验证 : 用户尝试访问
        权限验证 --> 访问拒绝 : 权限不足(X005)
        权限验证 --> 访问允许 : 权限足够
        访问拒绝 --> [*] : 记录违规(C066)
        访问允许 --> [*]
    }
    state "缺陷报告(Defect)" as Defect {
        [*] --> 新建
        新建 --> 已提交 : 用户提交(F009)
        已提交 --> 处理中 : 管理员分配
        处理中 --> 已解决 : 修复完成
        处理中 --> 已拒绝 : 无效报告
        已解决 --> 已关闭 : 用户确认
        已拒绝 --> 已关闭 : 管理员归档
        已关闭 --> [*]
    }
    state "系统配置(Configuration)" as Configuration {
        [*] --> 默认值
        默认值 --> 修改中 : 管理员调整
        修改中 --> 已保存 : 确认更改
        修改中 --> 默认值 : 取消更改
        已保存 --> [*] : 系统重启
    }