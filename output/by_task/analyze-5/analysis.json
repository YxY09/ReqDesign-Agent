  "constraints": [
    {
      "constraintRef": "C_RULE_003",
      "description": "系统必须能够向用户发送警报（如电子邮件、短信），当用户选择时，每当对警报采取任何行动时",
      "related_functions": [
        "FUN_SEND_ALERT"
      ],
      "source_text": "The solution should send alerts (e.g., email, SMS) to the user if the user chooses to whenever any action has been taken on the alert."
    },
    {
      "constraintRef": "C_RULE_002",
      "description": "系统必须提供界面让用户记录应用程序中的任何缺陷或增强请求并跟踪",
      "related_functions": [
        "FUN_TRACK_DEFECT"
      ],
      "source_text": "The solution should provide an interface for the user to log any defects or enhancement requests on the application and track thereafter."
    }
  ],
