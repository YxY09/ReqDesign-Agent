{
  "project_name": "CCTNS",
  "project_overview": "The Citizen Interface module of the CCTNS acts as a conduit for the information exchange between citizens and police units/personnel.",
  "actors": [
    {
      "actorRef": "A_CITIZEN",
      "name": "Citizen",
      "description": "公民用户，可以通过系统与警方进行信息交换"
    },
    {
      "actorRef": "A_POLICE_OFFICER",
      "name": "PoliceOfficer",
      "description": "警务人员，处理公民提交的信息和请求"
    }
  ],
  "functions": [
    {
      "id": "FUN_SEND_ALERT",
      "name": "SendAlert",
      "description": "向用户发送警报（如电子邮件、短信）",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "用户可以选择接收警报的方式",
        "当对警报采取行动时触发发送"
      ],
      "related_actors": [
        "A_CITIZEN"
      ],
      "priority": "high",
      "preconditions": "用户已选择接收警报"
    },
    {
      "id": "FUN_TRACK_DEFECT",
      "name": "TrackDefect",
      "description": "跟踪系统缺陷",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "用户可以查看缺陷状态",
        "帮助台用户可以按类别、状态和时间查看缺陷报告"
      ],
      "related_actors": [
        "A_CITIZEN",
        "A_HELP_DESK"
      ],
      "priority": "medium",
      "preconditions": "用户已登录系统"
    }
  ],
  "entities": [
