classDiagram
    class Case {
        -String caseId
        -String status
        -DateTime createdAt
        -String title
        -DateTime updatedAt
        +register()
        +investigate()
        +prosecute()
    }
    class Suspect {
        -String suspectId
        -String name
        -String status
        +addToCase()
        +updateStatus()
    }
    class Document {
        -String documentId
        -String type
        -String title
        +upload()
        +download()
        +linkToCase()
    }
    class AuditTrail {
        -String action
        -DateTime timestamp
        -String actionType
        -String userId
        -String entityId
        -String auditId
        +logAction()
        +exportTrail()
    }
    class Property {
        -String propertyId
        -String description
        -String status
        +register()
        +updateStatus()
    }
    class SearchResult {
        -String resultId
        -List items
        -String query
        -List results
        +search()
        +filterByAccess()
    }
    class UserProfile {
        -String userId
        -Object interfacePreferences
        -String securityLevel
        -List privileges
        -String role
        +savePreferences()
        +assignToGroup()
    }
    class Complaint {
        -String complaintId
        -String description
        -String status
        +register()
        +linkToCase()
    }
    Case "1" --> "*" Suspect : contains
    Case "1" --> "*" Document : has
    Case "1" --> "*" Property : includes
    Case "1" --> "*" AuditTrail : generates
    Case "1" --> "*" SearchResult : produces
    Suspect "*" --> "1" Case : belongs_to
    Document "*" --> "1" Case : associated_with
    Document "1" --> "1" Property : references
    AuditTrail "*" --> "1" Case : records
    AuditTrail "*" --> "1" UserProfile : performed_by
    Property "*" --> "1" Case : part_of
    Complaint "1" --> "1" Case : linked_to
    Complaint "*" --> "1" UserProfile : filed_by

    UserProfile "*" --> "*" Case : accesses