classDiagram
    class Case {
        -String caseId
        -String status
        -DateTime createdDate
        -String title
        -String description
        -DateTime lastAccessedAt
        +register()
        +investigate()
        +prosecute()
    }
    class Complaint {
        -String complaintId
        -String description
        -String status
        -DateTime createdAt
        -String reportedBy
        +submit()
        +updateStatus()
    }
    class Suspect {
        -String suspectId
        -String name
        -String description
        -String status
        +addToCase()
        +updateStatus()
    }
    class Evidence {
        -String evidenceId
        -String type
        -String description
        -DateTime collectedAt
        +validate()
        +store()
    }
    class Document {
        -String documentId
        -String type
        -String title
        -Object content
        +upload()
        +encrypt()
    }
    class SearchResult {
        -String searchId
        -String query
        -Integer resultCount
        -DateTime executedAt
        +filterByAccess()
        +paginate()
    }
    class UserProfile {
        -String userId
        -String username
        -String displayName
        -String role
        -Object uiSettings
        +checkPermission()
        +updateProfile()
    }
    class AccessControl {
        -String accessId
        -String resourceType
        -String resourceId
        -String permission
        +verifyAccess()
        +grantPermission()
    }
    class AuditTrail {
        -String auditId
        -String action
        -String entityType
        -String entityId
        -DateTime timestamp
        +export()
        +filterByDate()
    }
    class Configuration {
        -String configId
        -String key
        -String value
        -String scope
        +update()
        +getValue()
    }
    Case "1" --> "*" Suspect : contains
    Case "1" --> "*" Evidence : has
    Case "1" --> "*" Document : includes
    Complaint "1" --> "1" Case : leads to
    UserProfile "1" --> "*" AccessControl : has
    AccessControl "*" --> "1" Case : controls
    Case "1" --> "*" AuditTrail : generates
    UserProfile "1" --> "*" AuditTrail : performs
    SearchResult "*" --> "*" Case : references

