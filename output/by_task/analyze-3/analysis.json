  "constraints": [
    {
      "constraintRef": "C_RULE_019",
      "description": "界面必须尽可能可定制或用户可配置",
      "related_functions": [
        "FUN_CUSTOMIZE_INTERFACE"
      ],
      "source_text": "The interfaces must be made customizable or user-configurable to the extent possible. (e.g., the displayed columns in the table, move, resize, modify the appearance). Such configurations must be saved in the user profile."
    },
    {
      "constraintRef": "C_RULE_020",
      "description": "系统用户界面必须适合有特殊需求的用户",
      "related_functions": [
        "FUN_CUSTOMIZE_INTERFACE"
      ],
      "source_text": "The System user interface must be suitable for users with special needs; that is, compatible with specialist software that may be used and with appropriate interface guidelines"
    },
    {
      "constraintRef": "C_RULE_021",
      "description": "系统用户界面必须符合ISO 9241标准",
