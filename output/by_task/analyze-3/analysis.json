{
  "project_name": "CCTNS",
  "project_overview": "警察案件跟踪系统，用于记录和管理案件调查、起诉过程，提供与法院的交互平台",
  "actors": [
    {
      "actorRef": "A_POLICE_OFFICER",
      "name": "PoliceOfficer",
      "description": "警务人员，负责案件调查和起诉"
    },
    {
      "actorRef": "A_ADMIN",
      "name": "Admin",
      "description": "管理员，负责系统配置和用户管理"
    }
  ],
  "functions": [
    {
      "id": "FUN_PROSECUTE_CASE",
      "name": "ProsecuteCase",
      "description": "起诉案件，记录与法院的交互过程",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "能够记录案件起诉的详细信息",
        "能够跟踪案件在法院的进展状态"
      ],
      "related_actors": [
        "A_POLICE_OFFICER"
      ],
      "priority": "high",
      "preconditions": "案件必须已完成调查阶段"
    },
    {
      "id": "FUN_GENERATE_REPORT",
      "name": "GenerateReport",
      "description": "生成案件报告",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "能够生成案件详细报告",
        "报告格式应符合标准要求"
      ],
      "related_actors": [
        "A_POLICE_OFFICER",
        "A_ADMIN"
      ],
      "priority": "medium",
      "preconditions": "案件必须已存在"
    }
  ],
  "entities": [
    {
      "entityRef": "E_CASE",
      "name": "Case",
      "description": "案件记录",
      "attributes": [
        {
          "name": "caseId",
          "type": "String",
          "description": "案件唯一标识"
        },
        {
          "name": "status",
          "type": "String",
          "description": "案件当前状态"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "description": "案件创建时间"
        }
      ],
      "relationships": [
        {
          "target": "E_SUSPECT",
          "type": "one-to-many",
          "description": "案件关联的嫌疑人"
        },
        {
          "target": "E_DOCUMENT",
          "type": "one-to-many",
          "description": "案件关联的文档"
        }
      ]
    },
    {
      "entityRef": "E_SUSPECT",
      "name": "Suspect",
      "description": "案件嫌疑人",
      "attributes": [
        {
          "name": "suspectId",
          "type": "String",
          "description": "嫌疑人唯一标识"
        },
        {
          "name": "name",
          "type": "String",
          "description": "嫌疑人姓名"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "many-to-one",
          "description": "嫌疑人关联的案件"
        }
      ]
    },
    {
      "entityRef": "E_DOCUMENT",
      "name": "Document",
      "description": "案件相关文档",
      "attributes": [
        {
          "name": "documentId",
          "type": "String",
          "description": "文档唯一标识"
        },
        {
          "name": "type",
          "type": "String",
          "description": "文档类型"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "many-to-one",
          "description": "文档关联的案件"
        }
      ]
    }
  ],
  "constraints": [
    {
      "constraintRef": "C_RULE_004",
      "description": "系统必须维护不可更改的审计跟踪",
      "related_functions": [
        "FUN_PROSECUTE_CASE",
        "FUN_GENERATE_REPORT"
      ],
      "source_text": "The System must keep an unalterable audit trail capable of automatically capturing and storing information about:The word 'unalterable' is to mean that the audit trail data cannot be modified in any way or deleted by any user; it may be subject to re-department and copying to removable media if required, so long as its contents remain unchanged."
    },
    {
      "constraintRef": "C_RULE_010",
      "description": "系统必须允许用户将案件访问限制为指定用户或用户组",
      "related_functions": [
        "FUN_PROSECUTE_CASE"
      ],
      "source_text": "The System must allow the user to limit access to cases to specified users or user groups."
    },
    {
      "constraintRef": "C_RULE_011",
      "description": "系统应提供基于角色的功能控制",
      "related_functions": [
        "FUN_PROSECUTE_CASE",
        "FUN_GENERATE_REPORT"
      ],
      "source_text": "The system should provide for role-based control for the functionality within the system"
    }
  ],
  "missingConstraintCandidates": [],
  "exceptions": [],
  "non_functional_requirements": [
    {
      "category": "性能",
      "description": "系统必须能够在5-8秒内执行简单搜索，在10-15秒内执行高级搜索"
    },
    {
      "category": "安全",
      "description": "系统应防止SQL注入"
    },
    {
      "category": "可用性",
      "description": "系统用户界面必须适合有特殊需求的用户"
    }
  ],
  "business_processes": [
    {
      "name": "案件起诉流程",
      "steps": [
        "准备起诉材料",
        "提交法院",
        "记录法院反馈",
        "更新案件状态"
      ],
      "actors": [
        "A_POLICE_OFFICER"
      ]
    }
  ],
  "proposeNewEntities": [],
  "proposeNewFunctions": [],
  "proposeNewConstraints": [],
  "proposeNewExceptions": []
}