  "constraints": [
    {
      "constraintRef": "C_RULE_001",
      "description": "系统必须提供详细的上下文相关帮助材料，涵盖应用程序中所有用户界面的所有可能操作和场景。",
      "related_functions": [
        "FUN_NAVIGATE"
      ],
      "source_text": "The solution should provide detailed context-sensitive help material for all the possible actions and scenarios on all user interfaces in the application."
    },
    {
      "constraintRef": "C_RULE_002",
      "description": "系统必须提供一个界面，供用户记录应用程序上的任何缺陷或增强请求并跟踪。",
      "related_functions": [
        "FUN_LOG_DEFECT",
        "FUN_TRACK_DEFECT"
      ],
      "source_text": "The solution should provide an interface for the user to log any defects or enhancement requests on the application and track thereafter."
    },
    {
      "constraintRef": "C_RULE_003",
      "description": "系统必须能够发送警报（例如电子邮件、短信）给用户，如果用户选择在任何操作已采取时接收警报。",
      "related_functions": [
        "FUN_SEND_ALERT"
      ],
      "source_text": "The solution should send alerts (e.g., email, SMS) to the user if the user chooses to whenever any action has been taken on the alert."
    },
    {
      "constraintRef": "C_RULE_004",
      "description": "系统必须能够维护一个不可更改的审计跟踪，自动捕获和存储关于关键实体（案件、嫌疑人、财产等）的所有操作（创建/读取/更新/删除）的信息。",
      "related_functions": [
        "FUN_EXPORT_AUDIT_TRAIL"
      ],
      "source_text": "The System must keep an unalterable audit trail capable of automatically capturing and storing information about:The word “unalterable” is to mean that the audit trail data cannot be modified in any way or deleted by any user; it may be subject to re-department and copying to removable media if required, so long as its contents remain unchanged."
    },
    {
      "constraintRef": "C_RULE_005",
      "description": "系统必须允许用户将案件访问权限限制为指定的用户或用户组。",
      "related_functions": [
        "FUN_ACCESS_CONTROL"
      ],
      "source_text": "The System must allow the user to limit access to cases to specified users or user groups."
    },
    {
      "constraintRef": "C_RULE_006",
      "description": "系统必须仅允许管理员用户设置用户配置文件并将用户分配到组。",
      "related_functions": [
        "FUN_MANAGE_USER_PROFILE"
      ],
      "source_text": "The System must allow only admin-users to set up user profiles and allocate users to groups."
    },
    {
      "constraintRef": "C_RULE_007",
      "description": "系统必须确保所有错误消息都是有意义的，以便用户能够适当地采取行动。",
      "related_functions": [
        "All"
      ],
      "source_text": "All error messages produced by the System must be meaningful, so that they can be appropriately acted upon by the users who are likely to see them. Ideally, each error message will be accompanied by explanatory text and an indication of the action(s) which the user can take in response to the error."
    },
    {
      "constraintRef": "C_RULE_008",
      "description": "系统必须能够在5-8秒内执行简单搜索，在10-15秒内执行高级搜索（多个搜索条件），无论存储容量或系统中的案件数量如何。",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "The System must be able to perform a simple search within 5-8 seconds and a advanced search (multiple search criteria) within 10-15 seconds regardless of the storage capacity or number of cases in the system. In this context, performing a search means returning a result list. It does not include retrieving the records themselves."
    },
    {
      "constraintRef": "C_RULE_009",
      "description": "系统必须支持多语言界面。",
      "related_functions": [
        "FUN_CUSTOMIZE_UI"
      ],
      "source_text": "The system should support multilingual interface."
    },
    {
      "constraintRef": "C_RULE_010",
      "description": "系统必须使用HTTPS作为通信协议，即通过加密的安全套接字层（SSL）的HTTP。",
      "related_functions": [
        "All"
      ],
      "source_text": "The system should use HTTPS as the communication protocol, i.e., HTTP over an encrypted secure socket layer (SSL)."
    }
  ],
  "missingConstraintCandidates": [],
  "exceptions": [
    {
      "id": "X001",
      "description": "用户尝试访问无权限的案件",
      "trigger": "用户请求访问或搜索无权限的案件",
      "handling": "系统根据配置提供不同级别的响应：显示标题和元数据、仅显示案件存在、不显示任何信息"
    },
    {
      "id": "X002",
      "description": "用户尝试执行无权限的操作",
      "trigger": "用户尝试执行超出其权限范围的操作",
      "handling": "系统记录违规行为到审计跟踪，并向用户显示有意义的错误消息"
    }
  ],
