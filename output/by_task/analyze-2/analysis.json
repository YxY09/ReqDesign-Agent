{
  "project_name": "CCTNS",
  "project_overview": "CCTNS是一个警务案件管理系统，提供案件注册、调查、起诉、搜索等功能，支持警务人员与法院的交互。",
  "actors": [
    {
      "actorRef": "A_ADMIN",
      "name": "Admin",
      "description": "管理员"
    },
    {
      "actorRef": "A_POLICE_OFFICER",
      "name": "PoliceOfficer",
      "description": "警务人员"
    },
    {
      "actorRef": "A_CITIZEN",
      "name": "Citizen",
      "description": "公民"
    },
    {
      "actorRef": "A_HELP_DESK",
      "name": "HelpDesk",
      "description": "帮助台"
    },
    {
      "actorRef": "A_AUDITOR",
      "name": "Auditor",
      "description": "审计员"
    },
    {
      "actorRef": "A_RECORDS_STAFF",
      "name": "RecordsStaff",
      "description": "记录室工作人员"
    }
  ],
  "functions": [
    {
      "id": "FUN_PROSECUTE_CASE",
      "name": "ProsecuteCase",
      "description": "起诉案件",
      "sub_capabilities": [],
      "acceptance_criteria": [],
      "related_actors": [
        "A_POLICE_OFFICER"
      ],
      "priority": "high",
      "preconditions": "案件必须已完成调查"
    },
    {
      "id": "FUN_SEARCH_CASE",
      "name": "SearchCase",
      "description": "搜索案件",
      "sub_capabilities": [
        "基本搜索",
        "高级搜索"
      ],
      "acceptance_criteria": [
        "搜索结果必须在5-8秒内返回",
        "搜索结果不得包含用户无权访问的记录"
      ],
      "related_actors": [
        "A_POLICE_OFFICER",
        "A_ADMIN"
      ],
      "priority": "high",
      "preconditions": "用户必须已登录"
    }
  ],
  "entities": [
    {
      "entityRef": "E_CASE",
      "name": "Case",
      "description": "案件",
      "attributes": [
        {
          "name": "caseId",
          "type": "String",
          "description": "案件唯一标识"
        },
        {
          "name": "status",
          "type": "String",
          "description": "案件状态"
        }
      ],
      "relationships": [
        {
          "target": "Suspect",
          "type": "one-to-many",
          "description": "案件关联的嫌疑人"
        }
      ]
    },
    {
      "entityRef": "E_PROPERTY",
      "name": "Property",
      "description": "财产",
      "attributes": [
        {
          "name": "propertyId",
          "type": "String",
          "description": "财产唯一标识"
        },
        {
          "name": "description",
          "type": "String",
          "description": "财产描述"
        }
      ],
      "relationships": []
    },
    {
      "entityRef": "E_SEARCH_RESULT",
      "name": "SearchResult",
      "description": "搜索结果",
      "attributes": [
        {
          "name": "resultId",
          "type": "String",
          "description": "结果唯一标识"
        },
        {
          "name": "items",
          "type": "List",
          "description": "搜索结果项列表"
        }
      ],
      "relationships": []
    }
  ],
  "constraints": [
    {
      "constraintRef": "C_RULE_004",
      "description": "系统必须能够维护不可更改的审计跟踪",
      "related_functions": [
        "FUN_PROSECUTE_CASE",
        "FUN_SEARCH_CASE"
      ],
      "source_text": "The System must keep an unalterable audit trail capable of automatically capturing and storing information about:The word 'unalterable' is to mean that the audit trail data cannot be modified in any way or deleted by any user; it may be subject to re-department and copying to removable media if required, so long as its contents remain unchanged."
    },
    {
      "constraintRef": "C_RULE_015",
      "description": "搜索结果不得包含用户无权访问的记录",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "If a user performs a quick or advanced search, the System must never include in the search result list any record which the user does not have the right to access."
    }
  ],
  "missingConstraintCandidates": [],
  "exceptions": [
    {
      "id": "X001",
      "description": "用户无权访问案件",
      "trigger": "用户尝试访问无权限的案件",
      "handling": "记录审计跟踪并显示错误消息"
    }
  ],
  "non_functional_requirements": [
    {
      "category": "性能",
      "description": "系统必须能够在5-8秒内执行简单搜索"
    },
    {
      "category": "安全",
      "description": "系统必须维护不可更改的审计跟踪"
    }
  ],
  "business_processes": [
    {
      "name": "起诉流程",
      "steps": [
        "案件调查",
        "准备起诉材料",
        "提交法院",
        "记录法院反馈"
      ],
      "actors": [
        "A_POLICE_OFFICER"
      ]
    },
    {
      "name": "搜索流程",
      "steps": [
        "输入搜索条件",
        "执行搜索",
        "查看结果",
        "选择案件查看详情"
      ],
      "actors": [
        "A_POLICE_OFFICER",
        "A_ADMIN"
      ]
    }
  ],
  "proposeNewEntities": [],
  "proposeNewFunctions": [],
  "proposeNewConstraints": [],
