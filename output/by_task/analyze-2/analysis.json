{
  "project_name": "CCTNS",
  "project_overview": "警察案件跟踪系统，用于记录和管理案件从注册到起诉的全过程，并提供搜索功能",
  "actors": [
    {
      "actorRef": "A_POLICE_OFFICER",
      "name": "PoliceOfficer",
      "description": "警务人员，负责案件调查和起诉"
    },
    {
      "actorRef": "A_ADMIN",
      "name": "Admin",
      "description": "管理员，负责用户管理和系统配置"
    }
  ],
  "functions": [
    {
      "id": "FUN_PROSECUTE_CASE",
      "name": "ProsecuteCase",
      "description": "起诉案件，记录与法院的互动",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "能够记录法院互动的详细信息",
        "能够关联到特定案件"
      ],
      "related_actors": [
        "A_POLICE_OFFICER"
      ],
      "priority": "high",
      "preconditions": "案件必须已完成调查"
    },
    {
      "id": "FUN_SEARCH_CASE",
      "name": "SearchCase",
      "description": "搜索案件，支持基本和高级搜索",
      "sub_capabilities": [
        "按人员搜索",
        "按犯罪类型搜索",
        "按作案手法搜索",
        "按财产搜索"
      ],
      "acceptance_criteria": [
        "能够返回符合条件的案件列表",
        "能够自定义结果视图"
      ],
      "related_actors": [
        "A_POLICE_OFFICER"
      ],
      "priority": "high",
      "preconditions": "用户必须具有适当的访问权限"
    }
  ],
  "entities": [
    {
      "entityRef": "E_CASE",
      "name": "Case",
      "entityKind": "core",
      "description": "案件",
      "reifies": null,
      "attributes": [
        {
          "name": "caseId",
          "type": "String",
          "description": "案件唯一标识"
        },
        {
          "name": "status",
          "type": "String",
          "description": "案件状态"
        }
      ],
      "relationships": [
        {
          "target": "CaseProsecution",
          "type": "one-to-many",
          "description": "案件可以有多次起诉记录"
        }
      ]
    },
    {
      "entityRef": "E_CASE_PROSECUTION",
      "name": "CaseProsecution",
      "entityKind": "process_record",
      "description": "案件起诉记录",
      "reifies": {
        "source": "business_process",
        "sourceName": "ProsecuteCase",
        "endpoints": [
          "Case",
          "PoliceOfficer"
        ],
        "evidence": [
          "has_timestamp",
          "has_status"
        ]
      },
      "attributes": [
        {
          "name": "prosecutionId",
          "type": "String",
          "description": "起诉记录唯一标识"
        },
        {
          "name": "courtInteractionDetails",
          "type": "String",
          "description": "法院互动详情"
        },
        {
          "name": "date",
          "type": "DateTime",
          "description": "互动日期"
        }
      ],
      "relationships": [
        {
          "target": "Case",
          "type": "many-to-one",
          "description": "起诉记录关联到特定案件"
        }
      ]
    },
    {
      "entityRef": "E_SEARCH_RESULT",
      "name": "SearchResult",
      "entityKind": "process_record",
      "description": "搜索结果",
      "reifies": {
        "source": "business_process",
        "sourceName": "SearchCase",
        "endpoints": [
          "Case",
          "PoliceOfficer"
        ],
        "evidence": [
          "has_timestamp",
          "has_result"
        ]
      },
      "attributes": [
        {
          "name": "searchId",
          "type": "String",
          "description": "搜索唯一标识"
        },
        {
          "name": "criteria",
          "type": "String",
          "description": "搜索条件"
        },
        {
          "name": "resultCount",
          "type": "Integer",
          "description": "结果数量"
        }
      ],
      "relationships": [
        {
          "target": "Case",
          "type": "many-to-many",
          "description": "搜索结果关联到多个案件"
        }
      ]
    }
  ],
  "constraints": [
    {
      "constraintRef": "C_RULE_017",
      "description": "搜索结果列表中不得包含用户无权访问的记录",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "If a user performs a quick or advanced search, the System must never include in the search result list any record which the user does not have the right to access."
    },
    {
      "constraintRef": "C_RULE_028",
      "description": "系统必须能够在5-8秒内执行简单搜索",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "The System must be able to perform a simple search within 5-8 seconds and a advanced search (multiple search criteria) within 10-15 seconds regardless of the storage capacity or number of cases in the system. In this context, performing a search means returning a result list. It does not include retrieving the records themselves."
    },
    {
      "constraintRef": "C_RULE_029",
      "description": "系统必须能够在10-15秒内执行高级搜索",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "The System must be able to perform a simple search within 5-8 seconds and a advanced search (multiple search criteria) within 10-15 seconds regardless of the storage capacity or number of cases in the system. In this context, performing a search means returning a result list. It does not include retrieving the records themselves."
    }
  ],
  "missingConstraintCandidates": [],
  "exceptions": [
    {
      "id": "X001",
      "description": "用户尝试访问无权限的案件",
      "trigger": "用户尝试查看或搜索无权限的案件",
      "handling": "记录在审计跟踪中，并向用户显示适当错误消息"
    }
  ],
  "non_functional_requirements": [
    {
      "category": "性能",
      "description": "系统必须能够在5-8秒内执行简单搜索"
    },
    {
      "category": "性能",
      "description": "系统必须能够在10-15秒内执行高级搜索"
    },
    {
      "category": "安全",
      "description": "搜索结果列表中不得包含用户无权访问的记录"
    }
  ],
  "business_processes": [
    {
      "name": "案件起诉流程",
      "steps": [
        "选择案件",
        "记录法院互动",
        "保存起诉记录"
      ],
      "actors": [
        "A_POLICE_OFFICER"
      ]
    },
    {
      "name": "案件搜索流程",
      "steps": [
        "输入搜索条件",
        "执行搜索",
        "查看结果"
      ],
      "actors": [
        "A_POLICE_OFFICER"
      ]
    }
  ],
  "proposeNewEntities": [],
  "proposeNewFunctions": [],
  "proposeNewConstraints": [],
  "proposeNewExceptions": []
}