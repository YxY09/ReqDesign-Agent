{
  "project_name": "CCTNS",
  "project_overview": "CCTNS V1.0 is a system designed to improve crime investigation and criminal detection processes for police personnel.",
  "actors": [
    {
      "actorRef": "A_ADMIN",
      "name": "Admin",
      "description": "Administrator with full system access"
    },
    {
      "actorRef": "A_POLICE_OFFICER",
      "name": "PoliceOfficer",
      "description": "Police personnel responsible for case investigation"
    },
    {
      "actorRef": "A_CITIZEN",
      "name": "Citizen",
      "description": "Public user who can register complaints"
    },
    {
      "actorRef": "A_HELP_DESK",
      "name": "HelpDesk",
      "description": "Support staff handling user issues"
    },
    {
      "actorRef": "A_RECORDS_STAFF",
      "name": "RecordsStaff",
      "description": "Staff managing case records"
    },
    {
      "actorRef": "A_AUDITOR",
      "name": "Auditor",
      "description": "External auditor reviewing system activities"
    }
  ],
  "functions": [
    {
      "id": "FUN_REGISTER_CASE",
      "name": "RegisterCase",
      "description": "Allows citizens to register complaints with police",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "Complaint details are captured accurately",
        "Case reference number is generated"
      ],
      "related_actors": [
        "A_CITIZEN",
        "A_POLICE_OFFICER"
      ],
      "priority": "high",
      "preconditions": "User must be authenticated",
      "displayId": "F008"
    },
    {
      "id": "FUN_INVESTIGATE_CASE",
      "name": "InvestigateCase",
      "description": "Facilitates the investigation process after complaint registration",
      "sub_capabilities": [
        "Record evidence",
        "Update case status",
        "Generate investigation report"
      ],
      "acceptance_criteria": [
        "All investigation details are recorded",
        "Case status is updated appropriately"
      ],
      "related_actors": [
        "A_POLICE_OFFICER"
      ],
      "priority": "high",
      "preconditions": "Case must be registered",
      "displayId": "F004"
    },
    {
      "id": "FUN_SEARCH_CASE",
      "name": "SearchCase",
      "description": "Allows searching for cases",
      "sub_capabilities": [
        "Simple search",
        "Advanced search"
      ],
      "acceptance_criteria": [
        "Search results are returned within specified time limits",
        "Only accessible cases are shown"
      ],
      "related_actors": [
        "A_POLICE_OFFICER",
        "A_ADMIN"
      ],
      "priority": "medium",
      "preconditions": "User must have appropriate access rights"
    },
    {
      "id": "FUN_TRACK_DEFECT",
      "name": "TrackDefect",
      "description": "Allows users to log and track defects or enhancement requests",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "Defect details are captured",
        "Status updates are recorded"
      ],
      "related_actors": [
        "A_CITIZEN",
        "A_HELP_DESK"
      ],
      "priority": "medium",
      "preconditions": "User must be authenticated"
    },
    {
      "id": "FUN_EXPORT_AUDIT",
      "name": "ExportAudit",
      "description": "Exports audit trails for specified cases",
      "sub_capabilities": [],
      "acceptance_criteria": [
        "Audit data is exported without affecting stored audit trail"
      ],
      "related_actors": [
        "A_AUDITOR",
        "A_ADMIN"
      ],
      "priority": "low",
      "preconditions": "User must have audit access rights"
    }
  ],
  "entities": [
    {
      "entityRef": "E_CASE",
      "name": "Case",
      "entityKind": "core",
      "description": "Police case record",
      "reifies": null,
      "attributes": [
        {
          "name": "caseId",
          "type": "String",
          "description": "Unique identifier for the case"
        },
        {
          "name": "status",
          "type": "String",
          "description": "Current status of the case"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "description": "Date and time when case was created"
        }
      ],
      "relationships": [
        {
          "target": "E_SUSPECT",
          "type": "one-to-many",
          "description": "Case may involve multiple suspects"
        },
        {
          "target": "E_PROPERTY",
          "type": "one-to-many",
          "description": "Case may involve multiple properties"
        }
      ]
    },
    {
      "entityRef": "E_SUSPECT",
      "name": "Suspect",
      "entityKind": "core",
      "description": "Person suspected of involvement in a case",
      "reifies": null,
      "attributes": [
        {
          "name": "suspectId",
          "type": "String",
          "description": "Unique identifier for the suspect"
        },
        {
          "name": "name",
          "type": "String",
          "description": "Name of the suspect"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "many-to-one",
          "description": "Suspect may be involved in multiple cases"
        }
      ],
      "id": "E_SUSPECT",
      "canonicalName": "Suspect",
      "displayName": "Suspect"
    },
    {
      "entityRef": "E_PROPERTY",
      "name": "Property",
      "entityKind": "core",
      "description": "Property involved in a case",
      "reifies": null,
      "attributes": [
        {
          "name": "propertyId",
          "type": "String",
          "description": "Unique identifier for the property"
        },
        {
          "name": "description",
          "type": "String",
          "description": "Description of the property"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "many-to-one",
          "description": "Property may be involved in multiple cases"
        }
      ],
      "id": "E_PROPERTY",
      "canonicalName": "Property",
      "displayName": "Property"
    },
    {
      "entityRef": "E_CASE_REGISTRATION",
      "name": "CaseRegistration",
      "entityKind": "process_record",
      "description": "Record of a case registration",
      "reifies": {
        "source": "business_process",
        "sourceName": "RegisterCase",
        "endpoints": [
          "E_CASE",
          "A_CITIZEN"
        ],
        "evidence": [
          "has_timestamp",
          "has_status",
          "is_referenced_later"
        ]
      },
      "attributes": [
        {
          "name": "registrationId",
          "type": "String",
          "description": "Unique identifier for the registration"
        },
        {
          "name": "registrationDate",
          "type": "DateTime",
          "description": "Date and time of registration"
        },
        {
          "name": "complaintDetails",
          "type": "String",
          "description": "Details of the complaint"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "one-to-one",
          "description": "Registration creates a case"
        }
      ],
      "id": "E_CASE_REGISTRATION",
      "canonicalName": "CaseRegistration",
      "displayName": "CaseRegistration"
    },
    {
      "entityRef": "E_CASE_INVESTIGATION",
      "name": "CaseInvestigation",
      "entityKind": "process_record",
      "description": "Record of a case investigation",
      "reifies": {
        "source": "business_process",
        "sourceName": "InvestigateCase",
        "endpoints": [
          "E_CASE",
          "A_POLICE_OFFICER"
        ],
        "evidence": [
          "has_timestamp",
          "has_status",
          "has_report_or_evidence"
        ]
      },
      "attributes": [
        {
          "name": "investigationId",
          "type": "String",
          "description": "Unique identifier for the investigation"
        },
        {
          "name": "startDate",
          "type": "DateTime",
          "description": "Date and time investigation started"
        },
        {
          "name": "endDate",
          "type": "DateTime",
          "description": "Date and time investigation completed"
        },
        {
          "name": "findings",
          "type": "String",
          "description": "Investigation findings"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "one-to-one",
          "description": "Investigation is for a specific case"
        }
      ],
      "id": "E_CASE_INVESTIGATION",
      "canonicalName": "CaseInvestigation",
      "displayName": "CaseInvestigation"
    },
    {
      "entityRef": "E_AUDIT_TRAIL",
      "name": "AuditTrail",
      "entityKind": "log",
      "description": "Record of system activities",
      "reifies": null,
      "attributes": [
        {
          "name": "auditId",
          "type": "String",
          "description": "Unique identifier for the audit record"
        },
        {
          "name": "action",
          "type": "String",
          "description": "Action performed"
        },
        {
          "name": "timestamp",
          "type": "DateTime",
          "description": "Date and time of action"
        },
        {
          "name": "userId",
          "type": "String",
          "description": "User who performed action"
        }
      ],
      "relationships": [
        {
          "target": "E_CASE",
          "type": "many-to-one",
          "description": "Audit records may reference cases"
        }
      ]
    }
  ],
  "constraints": [
    {
      "constraintRef": "C_RULE_001",
      "description": "Provide context-sensitive help for all UI actions",
      "related_functions": [
        "FUN_REGISTER_CASE",
        "FUN_INVESTIGATE_CASE"
      ],
      "source_text": "The solution should provide detailed context-sensitive help material for all the possible actions and scenarios on all user interfaces in the application.",
      "id": "CON_PROVIDE_CONTEXT_SENSITIVE_HELP",
      "displayId": "C017"
    },
    {
      "constraintRef": "C_RULE_002",
      "description": "Provide interface for logging defects/enhancements",
      "related_functions": [
        "FUN_TRACK_DEFECT"
      ],
      "source_text": "The solution should provide an interface for the user to log any defects or enhancement requests on the application and track thereafter.",
      "id": "CON_PROVIDE_INTERFACE_LOGGING_DEFECTS",
      "displayId": "C018"
    },
    {
      "constraintRef": "C_RULE_004",
      "description": "Maintain unalterable audit trail",
      "related_functions": [
        "FUN_INVESTIGATE_CASE"
      ],
      "source_text": "The System must keep an unalterable audit trail capable of automatically capturing and storing information about:The word 'unalterable' is to mean that the audit trail data cannot be modified in any way or deleted by any user; it may be subject to re-department and copying to removable media if required, so long as its contents remain unchanged.",
      "unverified": true,
      "id": "CON_MAINTAIN_UNALTERABLE_AUDIT_TRAIL",
      "displayId": "C014"
    },
    {
      "constraintRef": "C_RULE_008",
      "description": "Export audit trails for specified cases",
      "related_functions": [
        "FUN_EXPORT_AUDIT"
      ],
      "source_text": "The System must be able to export audit trails for specified cases (without affecting the audit trail stored by the System). This functionality can be used by external auditors who wish to examine or analyse system activity.",
      "id": "CON_EXPORT_AUDIT_TRAILS_SPECIFIED",
      "displayId": "C013"
    },
    {
      "constraintRef": "C_RULE_017",
      "description": "Never show inaccessible records in search results",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "If a user performs a quick or advanced search, the System must never include in the search result list any record which the user does not have the right to access.",
      "id": "CON_NEVER_SHOW_INACCESSIBLE_RECORDS",
      "displayId": "C015"
    },
    {
      "constraintRef": "C_RULE_028",
      "description": "Perform simple search within 5-8 seconds",
      "related_functions": [
        "FUN_SEARCH_CASE"
      ],
      "source_text": "The System must be able to perform a simple search within 5-8 seconds and a advanced search (multiple search criteria) within 10-15 seconds regardless of the storage capacity or number of cases in the system. In this context, performing a search means returning a result list. It does not include retrieving the records themselves.",
      "id": "CON_PERFORM_SIMPLE_SEARCH_WITHIN",
      "displayId": "C016"
    }
  ],
  "missingConstraintCandidates": [],
  "exceptions": [
    {
      "id": "EXC_UNAUTHORIZED_ACCESS_ATTEMPT",
      "description": "Unauthorized access attempt",
      "trigger": "User attempts to access case without permission",
      "handling": "Log attempt in audit trail and show appropriate error message",
      "displayId": "X005"
    },
    {
      "id": "EXC_CASE_FOUND",
      "description": "Case not found",
      "trigger": "User searches for non-existent case",
      "handling": "Show appropriate error message",
      "displayId": "X004"
    }
  ],
  "non_functional_requirements": [
    {
      "category": "performance",
      "description": "System must perform simple search within 5-8 seconds"
    },
    {
      "category": "security",
      "description": "System must maintain unalterable audit trail"
    },
    {
      "category": "usability",
      "description": "User interfaces should comply with Standard ISO 9241"
    }
  ],
  "business_processes": [
    {
      "name": "CaseRegistration",
      "steps": [
        "Citizen submits complaint",
        "System generates case reference",
        "Case is assigned to investigating officer"
      ],
      "actors": [
        "A_CITIZEN",
        "A_POLICE_OFFICER"
      ]
    },
    {
      "name": "CaseInvestigation",
      "steps": [
        "Officer reviews case details",
        "Officer records evidence",
        "Officer updates case status",
        "System logs investigation activities"
      ],
      "actors": [
        "A_POLICE_OFFICER"
      ]
    }
  ],
