flowchart TD
    %% 案件注册流程
    subgraph 案件注册流程
        A1([开始]) --> A2[公民提交投诉]
        A2 --> A3[警务人员审核投诉]
        A3 --> A4{审核通过?}
        A4 -->|是| A5[系统登记案件]
        A5 --> A6[发送确认给公民]
        A6 --> A7([结束])
        A4 -->|否| A8[通知公民补充信息]
        A8 --> A2
    end
    %% 案件调查流程
    subgraph 案件调查流程
        B1([开始]) --> B2[警务人员访问案件]
        B2 --> B3{权限验证}
        B3 -->|通过| B4[收集证据]
        B4 --> B5[识别嫌疑人]
        B5 --> B6[更新案件状态]
        B6 --> B7[记录调查结果]
        B7 --> B8([结束])
        B3 -->|不通过| B9[X013: 无权限访问]
        B9 --> B8
    end
    %% 案件起诉流程
    subgraph 案件起诉流程
        C1([开始]) --> C2[记录法庭交互]
        C2 --> C3[更新案件状态]
        C3 --> C4[跟踪起诉进度]
        C4 --> C5([结束])
    end
    %% 案件搜索流程
    subgraph 案件搜索流程
        D1([开始]) --> D2[输入搜索条件]
        D2 --> D3{条件有效?}
        D3 -->|是| D4[执行搜索]
        D4 --> D5{找到结果?}
        D5 -->|是| D6[显示结果]
        D6 --> D7[自定义视图]
        D7 --> D8([结束])
        D3 -->|否| D9[X005: 无效条件]
        D5 -->|否| D10[X002: 无结果]
        D9 --> D2
        D10 --> D2
    end
    %% 缺陷管理流程
    subgraph 缺陷管理流程
        E1([开始]) --> E2[记录缺陷]
        E2 --> E3[分配缺陷]
        E3 --> E4[调查缺陷]
        E4 --> E5[解决缺陷]
        E5 --> E6{需要通知?}
        E6 -->|是| E7[通知用户]
        E7 --> E8([结束])
        E6 -->|否| E8
    end
    %% 用户配置流程
    subgraph 用户配置流程
        F1([开始]) --> F2[管理员创建用户]
        F2 --> F3{是管理员?}
        F3 -->|是| F4[分配用户组]
        F4 --> F5[设置访问权限]
        F5 --> F6([结束])
        F3 -->|否| F7[X001: 无权限]
        F7 --> F6
    end
    %% 流程间关系
    A7 --> B1
    B8 --> C1
    C5 --> D1
    D8 --> E1