flowchart TD
    subgraph 案件登记流程
        A1([开始]) --> A2[公民提交投诉]
        A2 --> A3[系统生成案件编号]
        A3 --> A4[分配调查警官]
        A4 --> A5[记录审计事件]
        A5 --> A6([结束])
    end
    subgraph 案件调查流程
        B1([开始]) --> B2[警官查看案件详情]
        B2 --> B3{权限检查?}
        B3 -->|通过| B4[记录证据]
        B3 -->|拒绝| B5[记录X005异常]
        B4 --> B6[更新案件状态]
        B6 --> B7[触发警报]
        B7 --> B8([结束])
        B5 --> B8
    end
    subgraph 案件搜索流程
        C1([开始]) --> C2[输入搜索条件]
        C2 --> C3[执行搜索]
        C3 --> C4[过滤无权限记录]
        C4 --> C5{找到结果?}
        C5 -->|是| C6[返回搜索结果]
        C5 -->|否| C7[显示X004错误]
        C6 --> C8[记录审计事件]
        C8 --> C9([结束])
        C7 --> C9
    end
    subgraph 审计导出流程
        D1([开始]) --> D2[选择案件]
        D2 --> D3{权限检查?}
        D3 -->|通过| D4[生成审计报告]
        D3 -->|拒绝| D5[记录X002异常]
        D4 --> D6{导出成功?}
        D6 -->|是| D7[下载报告]
        D6 -->|否| D8[记录X001错误]
        D7 --> D9([结束])
        D5 --> D9
        D8 --> D9
    end
    subgraph 界面自定义流程
        E1([开始]) --> E2[登录系统]
        E2 --> E3[访问设置页面]
        E3 --> E4[调整界面元素]
        E4 --> E5[保存配置]
        E5 --> E6([结束])
    end
    subgraph 缺陷跟踪流程
        F1([开始]) --> F2[提交缺陷请求]
        F2 --> F3[系统记录请求]
        F3 --> F4[帮助台处理]
        F4 --> F5[更新请求状态]
        F5 --> F6[通知用户]
        F6 --> F7([结束])
    end
    subgraph 警报发送流程
        G1([开始]) --> G2[配置接收方式]
        G2 --> G3[系统事件触发]
        G3 --> G4[发送警报]
        G4 --> G5[记录发送状态]
        G5 --> G6([结束])
    end