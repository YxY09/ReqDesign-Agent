flowchart TD
    subgraph 案件注册流程
        A1([开始]) --> A2[公民提交投诉]
        A2 --> A3{投诉信息完整?}
        A3 -->|是| A4[创建案件记录]
        A3 -->|否| A5[返回补充信息提示]
        A4 --> A6[关联投诉与案件]
        A6 --> A7[分配案件给警员]
        A7 --> A8[记录审计日志]
        A8 --> A9([结束])
        A5 --> A9
    end
    subgraph 案件调查流程
        B1([开始]) --> B2[警员查看案件详情]
        B2 --> B3[收集证据]
        B3 --> B4[询问证人]
        B4 --> B5[更新案件状态]
        B5 --> B6([结束])
    end
    subgraph 案件起诉流程
        C1([开始]) --> C2[准备起诉材料]
        C2 --> C3{案件状态为已调查?}
        C3 -->|是| C4[提交法院]
        C3 -->|否| C5[提示需先完成调查]
        C4 --> C6[记录法院反馈]
        C6 --> C7[更新案件状态]
        C7 --> C8([结束])
        C5 --> C8
    end
    subgraph 案件搜索流程
        D1([开始]) --> D2[输入搜索条件]
        D2 --> D3{检查缓存}
        D3 -->|命中| D4[从缓存获取结果]
        D3 -->|未命中| D5[查询数据库]
        D4 --> D6[过滤无权限记录]
        D5 --> D6
        D6 --> D7[返回分页结果]
        D7 --> D8([结束])
    end
    subgraph 系统配置流程
        E1([开始]) --> E2[管理员访问配置模块]
        E2 --> E3{有管理员权限?}
        E3 -->|是| E4[修改设置]
        E3 -->|否| E5[记录未授权尝试]
        E4 --> E6[保存更改]
        E6 --> E7[验证配置]
        E7 --> E8([结束])
        E5 --> E8
    end
    subgraph 访问控制流程
        F1([开始]) --> F2[选择案件]
        F2 --> F3[指定访问规则]
        F3 --> F4{规则有效?}
        F4 -->|是| F5[保存权限]
        F4 -->|否| F6[提示规则错误]
        F5 --> F7[验证限制]
        F7 --> F8([结束])
        F6 --> F8
    end
    subgraph 审计导出流程
        G1([开始]) --> G2[选择导出案件]
        G2 --> G3[生成导出文件]
        G3 --> G4{生成成功?}
        G4 -->|是| G5[验证导出内容]
        G4 -->|否| G6[记录错误并通知]
        G5 --> G7[交付审计员]
        G7 --> G8([结束])
        G6 --> G8
    end
    %% 异常处理节点
    A3 -->|X009 缺少必要证据| AX1[提示证据要求]
    AX1 --> A5
    D3 -->|X006 缓存不一致| DX1[清除缓存并刷新]
    DX1 --> D5
    D6 -->|X003 无权访问| DX2[显示配置的响应]
    DX2 --> D7
    E3 -->|X015 未授权配置| EX1[记录审计日志]
    EX1 --> E5
    F4 -->|X010 无效配置| FX1[显示验证错误]
    FX1 --> F6
    G4 -->|X005 导出失败| GX1[记录错误日志]
    GX1 --> G6