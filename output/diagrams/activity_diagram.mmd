flowchart TD
    %% 案件注册流程
    subgraph 案件注册流程
        A1([开始]) --> A2[公民提交投诉]
        A2 --> A3[警务人员填写案件信息]
        A3 --> A4{系统验证通过?}
        A4 -->|是| A5[系统生成案件ID]
        A4 -->|否| A6[返回错误信息]
        A5 --> A7[案件创建完成]
        A6 --> A3
        A7 --> A8([结束])
    end
    %% 案件调查流程
    subgraph 案件调查流程
        B1([开始]) --> B2[警务人员查看分配案件]
        B2 --> B3[系统显示相关警报和任务]
        B3 --> B4[警务人员分配调查员]
        B4 --> B5[收集证据]
        B5 --> B6[记录调查结果]
        B6 --> B7[更新案件状态]
        B7 --> B8([结束])
    end
    %% 案件起诉流程
    subgraph 案件起诉流程
        C1([开始]) --> C2[警务人员准备起诉材料]
        C2 --> C3[提交起诉]
        C3 --> C4{系统验证通过?}
        C4 -->|是| C5[系统记录起诉信息]
        C4 -->|否| C6[返回错误信息]
        C5 --> C7[更新案件状态]
        C6 --> C2
        C7 --> C8([结束])
    end
    %% 缺陷报告流程
    subgraph 缺陷报告流程
        D1([开始]) --> D2[公民/警务人员填写缺陷报告]
        D2 --> D3[提交报告]
        D3 --> D4[系统记录报告]
        D4 --> D5[分配帮助台人员]
        D5 --> D6([结束])
    end
    %% 公民信息交换流程
    subgraph 公民信息交换流程
        E1([开始]) --> E2[公民提交信息或请求]
        E2 --> E3[警务人员处理请求]
        E3 --> E4[系统发送响应给公民]
        E4 --> E5([结束])
    end
    %% 异常处理流程
    subgraph 异常处理
        F1[案件检索超时] --> F2[系统返回超时错误]
        F2 --> F3[建议优化搜索条件]
        G1[无权限访问案件] --> G2[系统记录审计跟踪]
        G2 --> G3[显示适当响应]
        H1[尝试修改审计记录] --> H2[系统拒绝请求]
        H2 --> H3[记录违规行为]
    end
    %% 主流程连接
    A8 --> B1
    B8 --> C1
    C8 --> D1
    D6 --> E1