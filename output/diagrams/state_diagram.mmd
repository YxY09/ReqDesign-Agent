stateDiagram-v2
    state "案件(Case)" as Case {
        [*] --> 已创建
        已创建 --> 调查中 : 分配警员
        调查中 --> 起诉中 : 收集足够证据
        调查中 --> 已关闭 : 证据不足
        起诉中 --> 已判决 : 法庭审理完成
        起诉中 --> 已关闭 : 撤诉
        已判决 --> 已关闭
        已关闭 --> [*]
    }
    state "投诉(Complaint)" as Complaint {
        [*] --> 已提交
        已提交 --> 已受理 : 验证通过(C011)
        已提交 --> 已拒绝 : 缺少必要证据(X009)
        已受理 --> 已关联 : 绑定到案件
        已关联 --> [*]
        已拒绝 --> [*]
    }
    state "嫌疑人(Suspect)" as Suspect {
        [*] --> 已登记
        已登记 --> 调查中 : 关联案件
        调查中 --> 已起诉 : 证据充分
        调查中 --> 已释放 : 证据不足
        已起诉 --> 已判决 : 法庭裁决
        已判决 --> [*]
        已释放 --> [*]
    }
    state "证据(Evidence)" as Evidence {
        [*] --> 已收集
        已收集 --> 已验证 : 检验完成
        已验证 --> 已归档 : 案件结束
        已验证 --> 已作废 : 发现无效(X006)
        已归档 --> [*]
        已作废 --> [*]
    }
    state "文档(Document)" as Document {
        [*] --> 已上传
        已上传 --> 已加密 : 敏感文档(F004)
        已上传 --> 已发布 : 非敏感文档
        已加密 --> 已解密 : 授权访问(F004)
        已解密 --> 已归档
        已发布 --> 已归档
        已归档 --> [*]
    }
    state "用户配置(UserProfile)" as UserProfile {
        [*] --> 已创建
        已创建 --> 已激活 : 管理员批准(C001)
        已激活 --> 已停用 : 违反政策
        已停用 --> 已激活 : 管理员恢复
        已激活 --> [*]
        已停用 --> [*]
    }
    state "访问控制(AccessControl)" as AccessControl {
        [*] --> 已配置
        已配置 --> 已验证 : 权限检查通过
        已配置 --> 已拒绝 : 权限不足(X002)
        已验证 --> 已记录 : 记录审计日志(C089)
        已拒绝 --> 已记录 : 记录违规(C092)
        已记录 --> [*]
    }
    state "审计记录(AuditTrail)" as AuditTrail {
        [*] --> 已生成
        已生成 --> 已存储 : 持久化完成
        已存储 --> 已导出 : 管理员请求(F007)
        已存储 --> 已过期 : 超出保留期限(C098)
        已导出 --> [*]
        已过期 --> [*]
    }
    state "系统配置(Configuration)" as Configuration {
        [*] --> 已加载
        已加载 --> 已更新 : 管理员修改(C103)
        已更新 --> 已验证 : 校验通过
        已更新 --> 已回滚 : 无效配置(X010)
        已验证 --> 已应用
        已应用 --> [*]
        已回滚 --> [*]
    }
    state "帮助请求(HelpRequest)" as HelpRequest {
        [*] --> 已提交
        已提交 --> 处理中 : 分配支持人员
        处理中 --> 已解决 : 提供解决方案
        处理中 --> 已关闭 : 无法解决
        已解决 --> 已关闭
        已关闭 --> [*]
    }