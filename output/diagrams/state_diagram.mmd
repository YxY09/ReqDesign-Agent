stateDiagram-v2
    state "Case" as Case {
        [*] --> 已注册
        已注册 --> 调查中 : 警务人员开始调查
        调查中 --> 起诉中 : 收集足够证据
        调查中 --> 已关闭 : 证据不足
        起诉中 --> 已判决 : 法院审理完成
        起诉中 --> 已关闭 : 撤销起诉
        已判决 --> [*]
        已关闭 --> [*]
    }
    state "Suspect" as Suspect {
        [*] --> 待调查
        待调查 --> 调查中 : 关联到案件
        调查中 --> 已起诉 : 证据充分
        调查中 --> 已释放 : 证据不足
        已起诉 --> 已定罪 : 法院判决
        已起诉 --> 已释放 : 撤销起诉
        已定罪 --> [*]
        已释放 --> [*]
    }
    state "Property" as Property {
        [*] --> 待评估
        待评估 --> 扣押中 : 确认为涉案财产
        扣押中 --> 已返还 : 调查结束且无争议
        扣押中 --> 已没收 : 法院判决没收
        已返还 --> [*]
        已没收 --> [*]
    }
    state "AuditTrail" as AuditTrail {
        [*] --> 记录中
        记录中 --> 已归档 : 达到归档条件
        已归档 --> [*]
    }
    state "UserProfile" as UserProfile {
        [*] --> 已创建
        已创建 --> 已激活 : 管理员批准
        已激活 --> 已停用 : 违反政策
        已停用 --> 已激活 : 管理员恢复
        已停用 --> [*]
        已激活 --> [*]
    }
    state "Defect" as Defect {
        [*] --> 已报告
        已报告 --> 处理中 : 分配给开发人员
        处理中 --> 已解决 : 修复完成
        处理中 --> 已拒绝 : 确认为非缺陷
        已解决 --> 已验证 : 测试通过
        已验证 --> 已部署 : 发布到生产
        已部署 --> [*]
        已拒绝 --> [*]
    }
    state "Document" as Document {
        [*] --> 已上传
        已上传 --> 已审核 : 管理员验证
        已审核 --> 已归档 : 案件结束
        已归档 --> [*]
    }