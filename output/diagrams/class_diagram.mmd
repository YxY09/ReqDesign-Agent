classDiagram
    class Case {
        -String caseId
        -String status
        -DateTime createdAt
        +updateStatus()
        +assignOfficer()
    }
    class Suspect {
        -String suspectId
        -String name
        +addToCase()
        +removeFromCase()
    }
    class Property {
        -String propertyId
        -String description
        +associateWithCase()
    }
    class CaseRegistration {
        -String registrationId
        -DateTime registrationDate
        -String complaintDetails
        +registerNewCase()
    }
    class CaseInvestigation {
        -String investigationId
        -DateTime startDate
        -DateTime endDate
        -String findings
        +recordEvidence()
        +completeInvestigation()
    }
    class AuditTrail {
        -String auditId
        -String action
        -DateTime timestamp
        -String userId
        -String eventType
        -String caseId
        -String details
        +logEvent()
        +exportForCase()
    }
    class CaseProsecution {
        -String prosecutionId
        -String courtInteractionDetails
        -DateTime date
        +recordCourtInteraction()
    }
    class SearchResult {
        -String searchId
        -String criteria
        -Integer resultCount
        +executeSearch()
        +filterByAccess()
    }
    class UserProfile {
        -Object uiSettings
        -Object defaultValues
        -String username
        -String role
        -Integer securityLevel
        +updateUISettings()
        +checkAccess()
    }
    class Configuration {
        -Object stateSpecificData
        -Object businessRules
        +updateConfiguration()
    }
    class DefectRequest {
        -String title
        -String description
        -String category
        -String status
        -DateTime submittedAt
        -String submittedBy
        +submitRequest()
        +updateStatus()
    }
    class Alert {
        -String type
        -String content
        -DateTime sentAt
        -String status
        -String recipientId
        +sendAlert()
        +trackStatus()
    }
    class AccessViolation {
        -DateTime timestamp
        -String attemptedAccess
        -String outcome
        +logViolation()
    }
    Case "1" --> "*" Suspect : involves
    Case "1" --> "*" Property : involves
    Case "1" --> "1" CaseRegistration : has
    Case "1" --> "1" CaseInvestigation : has
    Case "1" --> "*" CaseProsecution : has
    Case "1" --> "*" AuditTrail : has
    Case "*" -- "*" SearchResult : referenced_by
    UserProfile "1" --> "*" AccessViolation : has
    UserProfile "1" --> "*" Alert : receives
    UserProfile "1" --> "*" DefectRequest : submits
    AuditTrail "1" --> "1" UserProfile : performed_by