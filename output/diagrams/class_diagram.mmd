classDiagram
    class Case {
        -String caseId
        -String title
        -String description
        -String status
        -DateTime createdAt
        -DateTime updatedAt
        -Object accessControl
        -DateTime createdDate
        -DateTime lastAccessed
        +register()
        +investigate()
        +prosecute()
    }
    class Suspect {
        -String suspectId
        -String name
        -String description
        -String status
        +addToCase()
        +updateStatus()
    }
    class Property {
        -String propertyId
        -String name
        -String description
        -String status
        +markAsEvidence()
        +release()
    }
    class AuditTrail {
        -String auditId
        -String action
        -String userId
        -DateTime timestamp
        -String details
        +logEvent()
        +exportData()
    }
    class UserProfile {
        -String profileId
        -String userId
        -Object uiConfig
        -Object defaults
        -Object uiSettings
        -Object defaultValues
        -String languagePreference
        -String name
        -String role
        -Object uiPreferences
        +savePreferences()
        +resetDefaults()
    }
    class AccessControl {
        -String controlId
        -String userId
        -String groupId
        -Object securityAttributes
        -String securityLevel
        -List assignedGroups
        -Object casePermissions
        -String resourceType
        -String permissionLevel
        -List permissions
        +checkPermission()
        +updateSecurityAttributes()
    }
    class Defect {
        -String defectId
        -String description
        -String status
        -String category
        -DateTime createdAt
        -DateTime reportedDate
        -String priority
        +submit()
        +updateStatus()
    }
    class Configuration {
        -String configId
        -String name
        -String value
        -String description
        -Object settings
        +updateSetting()
        +rollbackChange()
    }
    Case "1" --> "*" Suspect : involves
    Case "1" --> "*" Property : contains
    Case "1" --> "*" AuditTrail : has
    UserProfile "1" --> "1" AccessControl : has
    UserProfile "1" --> "1" Navigation : has
    UserProfile "1" --> "*" Case : assigned
    Defect "1" --> "1" UserProfile : reportedBy


