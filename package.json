{
  "name": "reqdesign-agent",
  "version": "0.1.0",
  "description": "Multi-agent LLM system for requirements-driven software design",
  "type": "module",
  "main": "dist/src/main.js",
  "bin": {
    "reqdesign": "dist/src/main.js"
  },
  "vitest": {
    "exclude": [
      "node_modules",
      "dist",
      ".pytest-*",
      "test_run_temp"
    ]
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx src/main.ts",
    "chat": "tsx src/main.ts chat",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "commander": "^12.0.0",
    "fast-xml-parser": "^5.8.0",
    "openai": "^4.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
