flowchart TD
    subgraph 挂号流程
        A([开始]) --> B[患者查询号源]
        B --> C[选择医生和时段]
        C --> D{号源可用?}
        D -->|是| E[提交挂号]
        D -->|否| B
        E --> F[生成挂号记录]
        F --> G[进入排队队列]
        G --> H([结束])
    end
    subgraph 排队叫号流程
        I([开始]) --> J[患者签到]
        J --> K[系统分配队列位置]
        K --> L[大屏显示当前叫号]
        L --> M{医生叫号?}
        M -->|是| N[患者就诊]
        M -->|否| L
        N --> O{过号处理?}
        O -->|是| P[重新排队]
        O -->|否| Q([结束])
        P --> L
    end
    subgraph 医生排班流程
        R([开始]) --> S[设置排班规则]
        S --> T{排班冲突?}
        T -->|是| U[调整排班]
        T -->|否| V[生成排班表]
        U --> S
        V --> W[排班表展示]
        W --> X([结束])
    end
    subgraph 处方管理流程
        Y([开始]) --> Z[医生开具处方]
        Z --> AA[处方审核]
        AA --> AB{审核通过?}
        AB -->|是| AC[处方收费]
        AB -->|否| AD[退回修改]
        AD --> Z
        AC --> AE[处方发药]
        AE --> AF([结束])
    end
    subgraph 就诊流程
        AG([开始]) --> AH[患者签到]
        AH --> AI[排队叫号]
        AI --> AJ[医生接诊]
        AJ --> AK[书写病历]
        AK --> AL{需要处方/检查?}
        AL -->|是| AM[开具处方/检查单]
        AL -->|否| AN([结束])
        AM --> AN
    end
    subgraph 收费流程
        AO([开始]) --> AP[查询待缴费项目]
        AP --> AQ[计算费用]
        AQ --> AR{医保结算?}
        AR -->|是| AS[医保结算]
        AR -->|否| AT[自费支付]
        AS --> AU[生成收费记录]
        AT --> AU
        AU --> AV([结束])
    end
    subgraph 发药流程
        AW([开始]) --> AX[审核处方]
        AX --> AY{库存充足?}
        AY -->|是| AZ[配药]
        AY -->|否| BA[通知医生更换]
        BA --> AX
        AZ --> BB[发药]
        BB --> BC[更新库存]
        BC --> BD([结束])
    end
    subgraph 异常处理
        BE[挂号并发冲突 X001] --> BF[保证不超发]
        BG[过敏检测 X002] --> BH[自动拦截提醒]
        BI[检查设备故障 X004] --> BJ[自动改约并通知]
        BK[收费系统故障 X005] --> BL[缓存交易记录]
        BM[药品配伍禁忌 X006] --> BN[弹窗警告并阻止]
        BO[处方审核不通过 X007] --> BP[退回修改并通知]
        BQ[医保结算失败 X008] --> BR[转为自费并提示]
        BS[药品库存不足 X009] --> BT[通知医生更换]
    end