stateDiagram-v2
    state "Patient" as Patient {
        [*] --> 未注册
        未注册 --> 已注册 : 完成注册(F015)
        已注册 --> 已绑定医保 : 绑定医保(F015)
        已绑定医保 --> 已注册 : 解绑医保
        已注册 --> [*] : 注销账号
        已绑定医保 --> [*] : 注销账号
    }
    state "Registration" as Registration {
        [*] --> 待就诊
        待就诊 --> 已取消 : 患者取消预约(F005)
        待就诊 --> 就诊中 : 患者签到(F013)
        就诊中 --> 已完成 : 就诊结束
        已取消 --> [*]
        已完成 --> [*]
    }
    state "Schedule" as Schedule {
        [*] --> 未排班
        未排班 --> 已排班 : 设置排班(F009)
        已排班 --> 已取消 : 取消排班
        已排班 --> [*] : 排班过期
        已取消 --> [*]
    }
    state "Queue" as Queue {
        [*] --> 等待中
        等待中 --> 叫号中 : 呼叫患者(F013)
        叫号中 --> 已完成 : 就诊结束
        叫号中 --> 等待中 : 患者未应答
        已完成 --> [*]
    }
    state "MedicalRecord" as MedicalRecord {
        [*] --> 书写中
        书写中 --> 已完成 : 医生提交(F017)
        已完成 --> 已修改 : 医生修改(C002)
        已修改 --> 已完成 : 提交修改
        已完成 --> [*]
    }
    state "Prescription" as Prescription {
        [*] --> 开立中
        开立中 --> 待审核 : 医生提交(F011)
        待审核 --> 已驳回 : 药师驳回(X007)
        待审核 --> 已审核 : 药师通过(F011)
        已驳回 --> 开立中 : 医生修改
        已审核 --> 已收费 : 收费完成(F012)
        已收费 --> 已发药 : 药房发药
        已发药 --> 已退药 : 退药申请(C004)
        已退药 --> 已退费 : 退费执行(F014)
        已退药 --> [*]
        已发药 --> [*]
    }
    state "ExamOrder" as ExamOrder {
        [*] --> 待检查
        待检查 --> 检查中 : 患者报到(F010)
        检查中 --> 已完成 : 检查结束
        已完成 --> 报告待审核 : 录入报告
        报告待审核 --> 报告已发布 : 医生审核(C001)
        报告已发布 --> [*]
    }
    state "Payment" as Payment {
        [*] --> 待支付
        待支付 --> 已支付 : 收费成功(F012)
        待支付 --> 支付失败 : 系统故障(X005)
        支付失败 --> 已支付 : 重试成功
        已支付 --> 已退费 : 退费申请(F014)
        已退费 --> [*]
        已支付 --> [*]
    }
    state "Inventory" as Inventory {
        [*] --> 库存正常
        库存正常 --> 库存预警 : 库存不足
        库存正常 --> 近效期预警 : 有效期<3个月(C009)
        库存预警 --> 库存正常 : 补货完成
        近效期预警 --> 库存正常 : 药品出库
        近效期预警 --> 已过期 : 超过有效期(C007)
        已过期 --> [*]
    }
    state "MedicalReport" as MedicalReport {
        [*] --> 待录入
        待录入 --> 待审核 : 录入完成(F010)
        待审核 --> 已发布 : 医生审核通过(C001)
        待审核 --> 已驳回 : 审核不通过
        已驳回 --> 待录入 : 重新录入
        已发布 --> [*]
    }
    state "RefundApplication" as RefundApplication {
        [*] --> 申请中
        申请中 --> 已批准 : 医生审批通过(F014)
        申请中 --> 已拒绝 : 审批不通过
        已批准 --> 已完成 : 退费执行
        已完成 --> [*]
        已拒绝 --> [*]
    }