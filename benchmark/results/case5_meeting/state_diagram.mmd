stateDiagram-v2
    %% 预约记录状态机
    [*] --> 待提交
    待提交 --> 待审批 : 员工提交预约申请（大型会议室）
    待提交 --> 已批准 : 员工提交预约申请（小型会议室）
    待审批 --> 已批准 : 部门经理批准
    待审批 --> 已拒绝 : 部门经理拒绝
    已批准 --> 已取消 : 员工在会议开始前2小时内取消
    已批准 --> 已完成 : 会议时间结束
    已拒绝 --> [*]
    已取消 --> [*]
    已完成 --> [*]
    note right of 待提交 : 初始状态
    note right of 已拒绝 : 终止状态
    note right of 已取消 : 终止状态
    note right of 已完成 : 终止状态

    %% 会议室状态机
    state "会议室状态" as Room {
        [*] --> 可用
        可用 --> 维护中 : 管理员设置为维护
        维护中 --> 可用 : 管理员恢复可用
    }

    %% 设备状态机
    state "设备状态" as Equipment {
        [*] --> 正常
        正常 --> 故障 : 设备发生故障
        故障 --> 正常 : 设备修复完成
    }