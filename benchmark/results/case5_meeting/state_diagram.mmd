stateDiagram-v2
    [*] --> 待审批 : 提交申请
    待审批 --> 已批准 : 经理批准
    待审批 --> 已批准 : 自动批准 (小型会议室)
    待审批 --> 已拒绝 : 经理拒绝
    待审批 --> 已取消 : 员工取消
    已批准 --> 进行中 : 会议开始
    已批准 --> 已取消 : 员工取消
    已拒绝 --> [*]
    已取消 --> [*]
    进行中 --> 已完成 : 会议结束
    已完成 --> [*]

    state "审批记录" as Approval {
        [*] --> 待处理
        待处理 --> 已批准 : 经理批准
        待处理 --> 已拒绝 : 经理拒绝
        已批准 --> [*]
        已拒绝 --> [*]
    }