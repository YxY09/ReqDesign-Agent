classDiagram
    class 用户 {
        -String 用户ID
        -String 姓名
        -String 部门
        -String 角色
        +login()
        +logout()
        +getProfile()
    }
    class 员工 {
        +browseRooms()
        +submitReservation()
        +cancelReservation()
        +getMyReservations()
    }
    class 部门经理 {
        +getPendingApprovals()
        +approveReservation()
        +rejectReservation()
        +getDepartmentReservations()
    }
    class 系统管理员 {
        +addRoom()
        +updateRoom()
        +deleteRoom()
        +manageEquipment()
        +getAllReservations()
    }
    class 会议室 {
        -String 会议室ID
        -String 名称
        -int 容量
        -String 位置
        -String 状态
        +getAvailableTimeSlots(date)
        +updateInfo()
        +addEquipment()
    }
    class 设备 {
        -String 设备ID
        -String 类型
        -String 状态
        -String 所属会议室ID
        +updateStatus()
        +getDetails()
    }
    class 预约记录 {
        -String 预约ID
        -Date 日期
        -String 时间段
        -String 会议室ID
        -String 员工ID
        -String 状态
        -Date 创建时间
        +create()
        +cancel()
        +approve()
        +reject()
    }
    class 预约服务 {
        <<interface>>
        +browseRooms(date)
        +submitReservation(request)
        +cancelReservation(id, userId)
        +getMyReservations(userId)
    }
    class 审批服务 {
        <<interface>>
        +getPendingApprovals(managerId)
        +approveReservation(reservationId)
        +rejectReservation(reservationId, reason)
    }
    class 会议室管理服务 {
        <<interface>>
        +addRoom(roomInfo)
        +updateRoom(roomId, info)
        +deleteRoom(roomId)
        +manageEquipment(roomId, equipment)
    }

    用户 <|-- 员工
    用户 <|-- 部门经理
    用户 <|-- 系统管理员
    会议室 "1" *-- "*" 设备 : 包含
    预约记录 "*" --> "1" 会议室 : 预约
    预约记录 "*" --> "1" 用户 : 预约人
    预约服务 ..> 会议室 : 依赖
    预约服务 ..> 预约记录 : 依赖
    审批服务 ..> 预约记录 : 依赖
    会议室管理服务 ..> 会议室 : 依赖
    会议室管理服务 ..> 设备 : 依赖