flowchart TD
    subgraph 员工流程
        A([开始]) --> B[员工登录系统]
        B --> C[浏览会议室列表]
        C --> D[选择会议室与时间段]
        D --> E[提交预约申请]
        E --> F{会议室是否可用?}
        F -->|否| G[提示：该时段会议室已被占用]
        G --> C
        F -->|是| H{预约时间是否合法?}
        H -->|否| I[提示：不能预约已过去的时间]
        I --> C
        H -->|是| J{是否需要审批?<br>（大型会议室）}
        J -->|是| K[创建预约记录<br>状态：待审批]
        J -->|否| L[创建预约记录<br>状态：已批准]
        K --> M[通知部门经理]
        L --> N[预约成功]
        M --> N
        N --> O([结束])
    end

    subgraph 经理审批流程
        P([开始]) --> Q[部门经理登录系统]
        Q --> R[查看本部门待审批预约]
        R --> S[选择预约进行审批]
        S --> T{审批决定}
        T -->|批准| U[更新预约状态为：已批准]
        T -->|拒绝| V[更新预约状态为：已拒绝]
        U --> W[通知预约员工]
        V --> W
        W --> X([结束])
    end

    subgraph 取消预约流程
        Y([开始]) --> Z[员工登录系统]
        Z --> AA[查看个人预约记录]
        AA --> AB[选择要取消的预约]
        AB --> AC{是否在会议开始前2小时内?}
        AC -->|否| AD[提示：已超过取消期限]
        AD --> AA
        AC -->|是| AE[更新预约状态为：已取消]
        AE --> AF[取消成功]
        AF --> AG([结束])
    end

    subgraph 管理员管理流程
        AH([开始]) --> AI[管理员登录系统]
        AI --> AJ[选择管理功能]
        AJ --> AK{管理类型}
        AK -->|会议室管理| AL[添加/修改/删除会议室信息]
        AK -->|设备管理| AM[设置会议室设备]
        AL --> AN[保存更改]
        AM --> AN
        AN --> AO([结束])
    end