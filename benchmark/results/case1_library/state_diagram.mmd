stateDiagram-v2
    %% 图书实体状态
    state "图书状态" as BookState {
        [*] --> 可借
        可借 --> 已借出 : 学生借阅
        已借出 --> 可借 : 学生归还
    }

    %% 借阅记录实体状态
    state "借阅记录状态" as BorrowRecordState {
        [*] --> 借阅中
        借阅中 --> 已归还 : 学生归还
        借阅中 --> 逾期 : 超过30天
        逾期 --> 已归还 : 归还并缴纳罚款
        已归还 --> [*]
    }

    note right of BookState
        图书生命周期状态
        核心约束：同一时间一本图书只能被一个用户借阅
    end note

    note right of BorrowRecordState
        借阅记录生命周期状态
        核心约束：借阅期限为30天，超期需缴纳罚款
    end note