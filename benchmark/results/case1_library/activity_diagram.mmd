flowchart TD
    subgraph 学生操作
        A([开始]) --> B{是否已登录?}
        B -->|否| C[跳转登录页面]
        C --> D[输入学号和密码]
        D --> E[提交登录]
        E --> F{登录成功?}
        F -->|是| G[进入主菜单]
        F -->|否| C
        B -->|是| G
        G --> H{选择操作}
        H -->|搜索图书| I[输入搜索条件]
        I --> J[执行搜索]
        J --> K[显示搜索结果]
        K --> G
        H -->|借阅图书| L[输入图书ID]
        L --> M{图书状态是否为“可借”?}
        M -->|否| N[提示“该图书已被借出”]
        N --> G
        M -->|是| O{当前借阅数量是否<5?}
        O -->|否| P[提示“借阅数量已达上限”]
        P --> G
        O -->|是| Q[执行借阅操作]
        Q --> R[更新图书状态为“已借出”]
        R --> S[创建借阅记录]
        S --> G
        H -->|归还图书| T[输入借阅记录ID]
        T --> U{是否逾期?}
        U -->|是| V[提示逾期并计算罚款]
        V --> W[执行归还操作]
        U -->|否| W
        W --> X[更新图书状态为“可借”]
        X --> Y[更新借阅记录]
        Y --> G
        H -->|查看记录| Z[查询个人借阅记录]
        Z --> AA[显示借阅记录]
        AA --> G
        G --> AB[退出系统]
        AB --> AC([结束])
    end

    subgraph 管理员操作
        AD([开始]) --> AE{是否已登录?}
        AE -->|否| AF[跳转登录页面]
        AF --> AG[输入账号和密码]
        AG --> AH[提交登录]
        AH --> AI{登录成功?}
        AI -->|是| AJ[进入主菜单]
        AI -->|否| AF
        AE -->|是| AJ
        AJ --> AK{选择操作}
        AK -->|图书管理| AL{选择管理操作}
        AL -->|添加图书| AM[输入新图书信息]
        AM --> AN[保存图书信息]
        AN --> AJ
        AL -->|删除图书| AO[输入图书ID]
        AO --> AP[删除图书信息]
        AP --> AJ
        AL -->|修改图书| AQ[输入图书ID和新信息]
        AQ --> AR[更新图书信息]
        AR --> AJ
        AK -->|查看所有借阅记录| AS[查询所有借阅记录]
        AS --> AT[显示所有借阅记录]
        AT --> AJ
        AJ --> AU[退出系统]
        AU --> AV([结束])
    end