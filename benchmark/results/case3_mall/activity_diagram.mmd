flowchart TD
    A([开始]) --> B[顾客浏览商品]
    B --> C[将商品加入购物车]
    C --> D[提交订单]
    D --> E{检查库存是否充足?}
    E -->|是| F[创建订单，状态为待支付]
    E -->|否| G[提示“库存不足”]
    G --> B
    F --> H[调用支付模块发起支付]
    H --> I{支付是否成功?}
    I -->|是| J[更新订单状态为已支付]
    I -->|否| K[订单状态变为支付失败]
    K --> L[用户可重新支付]
    L --> H
    J --> M[通知商家处理订单]
    M --> N[商家确认订单并发货]
    N --> O[更新订单状态为已发货]
    O --> P[顾客确认收货]
    P --> Q[更新订单状态为已完成]
    Q --> R([结束])
    F --> S[消息与调度模块启动30分钟超时计时]
    S --> T{订单是否在30分钟内支付?}
    T -->|是| H
    T -->|否| U[自动取消订单并释放库存]
    U --> R
    O --> V[顾客申请退款]
    V --> W{是否在收货后7天内?}
    W -->|是| X[提交退款申请]
    W -->|否| Y[提示“已超过退款期限”]
    Y --> R
    X --> Z[商家审核退款申请]
    Z --> AA{是否同意退款?}
    AA -->|是| AB[执行原路退款]
    AB --> AC[更新订单状态为已退款]
    AC --> R
    AA -->|否| AD[退款申请被拒绝]
    AD --> R
    J --> AE[顾客在发货前取消订单]
    AE --> AF[更新订单状态为已取消]
    AF --> AG[释放库存]
    AG --> R