flowchart TD
    A([开始]) --> B[顾客浏览商品]
    B --> C[将商品加入购物车]
    C --> D[进入购物车]
    D --> E[选择商品下单]
    E --> F{库存是否充足?}
    F -->|否| G[提示“库存不足”]
    G --> D
    F -->|是| H[创建订单（状态：待支付）]
    H --> I[选择支付方式并支付]
    I --> J{支付是否成功?}
    J -->|否| K[订单状态变为“支付失败”]
    K --> L[用户可重新支付]
    L --> I
    J -->|是| M[更新订单状态为“已支付”]
    M --> N[通知商家处理订单]
    N --> O[商家确认订单并发货]
    O --> P[更新订单状态为“已发货”]
    P --> Q[顾客确认收货]
    Q --> R[更新订单状态为“已完成”]
    R --> S([结束])

    subgraph 退款流程
        T([开始]) --> U[顾客申请退款]
        U --> V{是否在收货后7天内?}
        V -->|否| W[提示“已超过退款期限”]
        W --> X([结束])
        V -->|是| Y[创建退款申请（状态：待审核）]
        Y --> Z[商家审核退款申请]
        Z --> AA{商家是否同意?}
        AA -->|否| AB[退款申请被拒绝]
        AB --> AC([结束])
        AA -->|是| AD[执行原路退款]
        AD --> AE[更新退款状态为“已完成”]
        AE --> AF([结束])
    end

    subgraph 取消订单流程
        AG([开始]) --> AH[顾客申请取消订单]
        AH --> AI{订单是否已发货?}
        AI -->|是| AJ[提示“已发货订单不能取消”]
        AJ --> AK([结束])
        AI -->|否| AL[取消订单]
        AL --> AM[恢复商品库存]
        AM --> AN[更新订单状态为“已取消”]
        AN --> AO([结束])
    end