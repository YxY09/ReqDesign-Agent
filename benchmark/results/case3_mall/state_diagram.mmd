stateDiagram-v2
    state "订单状态" as Order {
        [*] --> 待支付 : 创建订单
        待支付 --> 已支付 : 支付成功
        待支付 --> 待支付 : 支付失败
        待支付 --> 已取消 : 超时未支付
        已支付 --> 已发货 : 商家发货
        已支付 --> 退款中 : 顾客申请退款
        已发货 --> 已完成 : 顾客确认收货
        已发货 --> 退款中 : 顾客申请退款
        退款中 --> 已取消 : 退款完成
        已完成 --> [*]
        已取消 --> [*]
    }

    state "退款状态" as Refund {
        [*] --> 待审核 : 顾客申请退款
        待审核 --> 已批准 : 商家批准
        待审核 --> 已拒绝 : 商家拒绝
        已批准 --> 已完成 : 退款执行完成
        已拒绝 --> [*]
        已完成 --> [*]
    }